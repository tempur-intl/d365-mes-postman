              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"_companyId\": \"{{company_id}}\",\n  \"_messageQueue\": \"JmgMES3P\",\n  \"_messageType\": \"ProdProductionOrderPickingList\",\n  \"_messageContent\": \"{\\\"ProductionOrderNumber\\\":\\\"{{prod_order}}\\\",\\\"PickingListLines\\\":[{\\\"ItemNumber\\\":\\\"{{item_number}}\\\",\\\"ConsumptionBOMQuantity\\\":{{consumed_qty}},\\\"ConsumptionDate\\\":\\\"{{consumption_date}}\\\"}]}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/services/SysMessageServices/SysMessageService/SendMessage",
              "host": [
                "{{base_url}}"
