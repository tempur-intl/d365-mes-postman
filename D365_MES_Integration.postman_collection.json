        {
          "name": "Material Consumption (Picking List)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The body contains the PickingList message content as readable JSON with {{variable}} tokens.",
                  "// Edit the body directly to change fields or add more lines to PickingListLines.",
                  "// This script resolves variables, then wraps it in the SysMessageService envelope before sending.",
                  "const rawBody = pm.request.body.raw;",
                  "const resolved = pm.variables.replaceIn(rawBody);",
                  "let msgObj;",
                  "try {",
                  "    msgObj = JSON.parse(resolved);",
                  "} catch (e) {",
                  "    console.error('Picking list body is not valid JSON after variable substitution:', e.message);",
                  "    throw e;",
                  "}",
                  "const envelope = JSON.stringify({",
                  "    _companyId: pm.variables.replaceIn('{{company_id}}'),",
                  "    _messageQueue: 'JmgMES3P',",
                  "    _messageType: 'ProdProductionOrderPickingList',",
                  "    _messageContent: JSON.stringify(msgObj)",
                  "}, null, 2);",
                  "pm.request.body.update({ mode: 'raw', raw: envelope });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ProductionOrderNumber\": \"{{prod_order}}\",\n  \"PickingListLines\": [\n    {\n      \"ItemNumber\": \"{{item_number}}\",\n      \"ConsumptionBOMQuantity\": {{consumed_qty}},\n      \"ConsumptionDate\": \"{{consumption_date}}\",\n      \"ItemBatchNumber\": \"{{item_batch_number}}\",\n      \"LicensePlateNumber\": \"{{license_plate_number}}\",\n      \"ProductionWarehouseLocationId\": \"{{production_warehouse_location_id}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/services/SysMessageServices/SysMessageService/SendMessage",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "services",
                "SysMessageServices",
                "SysMessageService",
                "SendMessage"
              ]
            }
          },
          "response": []
