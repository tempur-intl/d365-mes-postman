        "type": "text/javascript",
        "exec": [
          "const today = new Date().toISOString().split('T')[0];",
          "if (!pm.collectionVariables.get(\"started_date\")) { pm.collectionVariables.set(\"started_date\", today); }",
          "if (!pm.collectionVariables.get(\"report_date\")) { pm.collectionVariables.set(\"report_date\", today); }",
          "if (!pm.collectionVariables.get(\"consumption_date\")) { pm.collectionVariables.set(\"consumption_date\", today); }",
          "if (!pm.collectionVariables.get(\"ended_date\")) { pm.collectionVariables.set(\"ended_date\", today); }"
        ]
      }
