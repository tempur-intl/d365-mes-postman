            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"_companyId\": \"{{company_id}}\",\n  \"_messageQueue\": \"JmgMES3P\",\n  \"_messageType\": \"ProdProductionOrderRouteCard\",\n  \"_messageContent\": \"{\\\"ProductionOrderNumber\\\":\\\"{{prod_order}}\\\",\\\"RouteCardLines\\\":[{\\\"OperationNumber\\\":{{operation_num}},\\\"Hours\\\":{{hours}},\\\"ConsumptionDate\\\":\\\"{{consumption_date}}\\\"}]}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/services/SysMessageServices/SysMessageService/SendMessage",
