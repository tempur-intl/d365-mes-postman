    {
      "name": "Business Events (Service Bus)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Parse Service Bus connection string and generate a SAS token",
              "const connStr = pm.environment.get('servicebus_connection_string') || '';",
              "if (!connStr) {",
              "    console.error('servicebus_connection_string is not set in the environment.');",
              "    return;",
              "}",
              "",
              "// Extract each field with regex - handles ; or whitespace/newline separators",
              "const endpointMatch = connStr.match(/Endpoint=([^\\s;]+)/i);",
              "const keyNameMatch  = connStr.match(/SharedAccessKeyName=([^\\s;]+)/i);",
              "const sakMatch      = connStr.match(/SharedAccessKey=([^\\s;]+)/i);",
              "",
              "const endpoint = endpointMatch ? endpointMatch[1].trim() : '';",
              "const keyName  = keyNameMatch  ? keyNameMatch[1].trim()  : '';",
              "const keyValue = sakMatch      ? sakMatch[1].trim()      : '';",
              "",
              "if (!endpoint || !keyName || !keyValue) {",
              "    console.error('Could not parse connection string. endpoint=' + endpoint + ' keyName=' + keyName);",
              "    return;",
              "}",
              "",
              "// Extract hostname only: sb://ns.servicebus.windows.net/ -> ns.servicebus.windows.net",
              "const hostname = endpoint.replace(/^sb:\\/\\//i, '').replace(/\\/+$/, '');",
              "pm.environment.set('servicebus_namespace', hostname);",
              "",
              "// SAS token expiry: 1 hour from now",
              "const expiry = Math.floor(Date.now() / 1000) + 3600;",
              "const resourceUri = encodeURIComponent('https://' + hostname).toLowerCase();",
              "const stringToSign = resourceUri + '\\n' + expiry;",
              "",
              "// Sign with CryptoJS (available in Postman sandbox)",
              "const hash    = CryptoJS.HmacSHA256(stringToSign, keyValue);",
              "const sig     = encodeURIComponent(CryptoJS.enc.Base64.stringify(hash));",
              "const sasToken = `SharedAccessSignature sr=${resourceUri}&sig=${sig}&se=${expiry}&skn=${keyName}`;",
              "pm.environment.set('servicebus_sas_token', sasToken);"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Peek - TSIProductionOrderReleasedToMESBusinessEvent",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 204) {",
                  "    console.log('No messages available in subscription.');",
                  "    pm.test('No messages (204 No Content)', () => pm.response.to.have.status(204));",
                  "    return;",
                  "}",
                  "",
                  "pm.test('Message peeked successfully (201 Created)', () => pm.response.to.have.status(201));",
                  "",
                  "// Parse broker metadata from response header",
                  "const brokerHeader = pm.response.headers.get('BrokerProperties');",
                  "if (!brokerHeader) {",
                  "    console.warn('BrokerProperties header not found.');",
                  "    return;",
                  "}",
                  "",
                  "let broker;",
                  "try { broker = JSON.parse(brokerHeader); }",
