  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get OAuth Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"access_token\", jsonData.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}"
                },
                {
                  "key": "resource",
                  "value": "{{base_url}}"
                }
              ]
            },
            "url": {
              "raw": "https://login.microsoftonline.com/{{tenant_id}}/oauth2/token",
              "protocol": "https",
              "host": [
                "login",
                "microsoftonline",
                "com"
              ],
              "path": [
                "{{tenant_id}}",
                "oauth2",
                "token"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Production Orders",
      "item": [
        {
          "name": "Start Production Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"_companyId\": \"{{company_id}}\",\n  \"_messageQueue\": \"JmgMES3P\",\n  \"_messageType\": \"ProdProductionOrderStart\",\n  \"_messageContent\": \"{\\\"ProductionOrderNumber\\\":\\\"{{prod_order}}\\\",\\\"StartedQuantity\\\":{{started_qty}},\\\"StartedDate\\\":\\\"{{started_date}}\\\",\\\"AutomaticBOMConsumptionRule\\\":\\\"FlushingPrincip\\\",\\\"AutomaticRouteConsumptionRule\\\":\\\"RouteDependent\\\"}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/services/SysMessageServices/SysMessageService/SendMessage",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "services",
                "SysMessageServices",
                "SysMessageService",
                "SendMessage"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Report as Finished",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"_companyId\": \"{{company_id}}\",\n  \"_messageQueue\": \"JmgMES3P\",\n  \"_messageType\": \"ProdProductionOrderReportFinished\",\n  \"_messageContent\": \"{\\\"ProductionOrderNumber\\\":\\\"{{prod_order}}\\\",\\\"ReportFinishedLines\\\":[{\\\"ItemNumber\\\":\\\"{{item_number}}\\\",\\\"ReportedGoodQuantity\\\":{{good_qty}},\\\"ReportAsFinishedDate\\\":\\\"{{report_date}}\\\"}]}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/services/SysMessageServices/SysMessageService/SendMessage",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "services",
                "SysMessageServices",
                "SysMessageService",
                "SendMessage"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Material Consumption (Picking List)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
